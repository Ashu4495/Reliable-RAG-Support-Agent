# LLM Configuration (Set either GEMINI_API_KEY or OPENAI_API_KEY)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Preferred Provider: gemini or openai (defaults to auto-detection based on available key)
LLM_PROVIDER=gemini

# Application Settings
DEBUG_MODE=false
RAG_RELEVANCE_THRESHOLD=1.5
KNOWLEDGE_BASE_DIR=knowledge-base
ORDERS_DATA_PATH=data/orders.json

